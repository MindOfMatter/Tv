@media (min-width: 1012px) {
  [data-color-mode="light"][data-light-theme*="dark"] .dependabot-rules-banner-container, [data-color-mode="dark"][data-dark-theme*="dark"] .dependabot-rules-banner-container { background-image: url("/images/modules/dependabot-alerts/rules-promo-banner-dark.svg") !important; }
}

