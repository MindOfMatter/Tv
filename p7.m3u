.IssueLabel { font-size: 12px; font-weight: var(--base-text-weight-medium,500); white-space: nowrap; border: 1px solid rgba(0, 0, 0, 0); border-radius: 2em; padding: 0px 7px; line-height: 18px; display: inline-block; }

