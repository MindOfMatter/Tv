.IssueLabel:hover { text-decoration: none; }

.IssueLabel--big { padding-left: 10px; padding-right: 10px; line-height: 22px; }

.AnimatedEllipsis { vertical-align: bottom; display: inline-block; overflow: hidden; }

.AnimatedEllipsis::after { content: "..."; animation: 1.2s steps(4, jump-none) 0s infinite normal none running AnimatedEllipsis-keyframes; display: inline-block; }

@keyframes AnimatedEllipsis-keyframes { 
  0% { transform: translate(-100%); }
