development-menu .development-menu-component-menu-modal, development-menu .development-menu-component-dialog-modal { margin-top: var(--base-size-4) !important; }

development-menu .SelectMenu-item:hover, development-menu .SelectMenu-item:focus-visible { color: var(--fgColor-onEmphasis) !important; background-color: var(--bgColor-accent-emphasis) !important; }

