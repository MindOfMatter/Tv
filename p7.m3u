  [popover]:not(.\:popover-open) { display: none; }
}

.Overlay { width: min(var(--overlay-width),100vw - 2rem); min-width: 192px; max-height: min(100vh - 2rem,var(--overlay-height)); color: var(--fgColor-default); white-space: normal; background-color: var(--overlay-bgColor); border-radius: var(--borderRadius-large); box-shadow: var(--shadow-floating-small); opacity: 1; border: 0px; flex-direction: column; margin: auto; padding: 0px; display: flex; position: static; inset: 0px; }

