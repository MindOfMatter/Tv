.Overlay-closeButton:focus, .Overlay-closeButton:hover { background-color: var(--button-default-bgColor-hover); border: var(--borderWidth-thin) solid var(--control-bgColor-hover); }

.Overlay-closeButton.close-button { border: var(--borderWidth-thin) solid #0000; }

.Overlay--full { flex-grow: 1; width: 100%; max-width: 100vw; height: 100%; max-height: 100vh; border-radius: unset !important; }

@media (max-width: 767px) {
  .Overlay--placement-right-whenNarrow, .Overlay.Overlay--placement-left-whenNarrow { height: 100%; max-height: 100vh; position: fixed; }
  .Overlay.Overlay--placement-left-whenNarrow { border-top-left-radius: 0px; border-bottom-left-radius: 0px; animation-name: Overlay--motion-slideInLeft; inset: 0px auto 0px 0px; }
  .Overlay.Overlay--placement-right-whenNarrow { border-top-right-radius: 0px; border-bottom-right-radius: 0px; animation-name: Overlay--motion-slideInLeft; inset: 0px 0px 0px auto; }
  .Overlay.Overlay--placement-bottom-whenNarrow { border-bottom-right-radius: 0px; border-bottom-left-radius: 0px; width: 100%; max-width: 100vw; animation-name: Overlay--motion-slideUp; inset: auto 0px 0px; }
  .Overlay--full-whenNarrow { flex-grow: 1; width: 100%; max-width: 100vw; height: 100%; max-height: 100vh; border-radius: unset !important; }
  .Overlay--fullscreen-whenNarrow { width: 100vw; height: 100vh; margin: 0px; position: fixed; top: 0px; left: 0px; border-radius: unset !important; max-width: none !important; max-height: none !important; }
